Reason: Real Shadows (port_shadows.h, the pause menu's Settings, Graphics): as the main camera sets its projection (CPolarSubCamera::perform), the sun's direction and the shadow map's box round Mario go to the renderer with the camera's view (port_shadows_main_view, ext/core/game/port_shadows.cpp); what that view draws casts into the map and receives its shadows. Off, nothing changes.

--- a/src/Camera/cameragc.cpp
+++ b/src/Camera/cameragc.cpp
@@ -20,6 +20,7 @@
 #ifdef TARGET_PC
 #include <sms_modhook.h>
 #include "port_ext.h"
+#include "port_shadows.h"
 #endif
 
 #include <System/StageUtil.hpp>
@@ -1272,8 +1273,15 @@
 		graphics->setViewMtx(unk1EC);
 		graphics->mNearPlane = mNear;
 		graphics->mFarPlane  = mFar;
-		if (cue & CUE_SET_PROJECTION)
+		if (cue & CUE_SET_PROJECTION) {
 			GXSetProjection(graphics->mProjMtx.mMtx, GX_PERSPECTIVE);
+#ifdef TARGET_PC
+			// port: Real Shadows (port_shadows.h): the sun's shadow map for
+			// this view, which the main camera's draws from here cast into
+			// and receive
+			port_shadows_main_view(this, graphics->mViewMtx);
+#endif
+		}
 	}
 }
 
