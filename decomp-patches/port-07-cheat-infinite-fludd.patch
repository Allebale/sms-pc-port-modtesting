+#ifdef TARGET_PC
+extern "C" int port_cheat_infinite_fludd;
+#endif
+
+static bool infiniteFludd(TWaterGun* fludd)
+{
+#ifdef TARGET_PC
+	return port_cheat_infinite_fludd && fludd->getMario()->isMario();
+#else
+	return false;
+#endif
+}
+
+// the bombs keep their timers: while one is ACTIVE, TNozzleDeform::emit() stops its normal stream;
+// so does the Rocket: its timer is how long it pushes Mario up, so how high he goes
+static bool infiniteTriggerDuration(TNozzleTrigger* trigger)
+{
+	return infiniteFludd(trigger->mFludd) && trigger != &trigger->mFludd->mNozzleRocket
+	    && trigger != &trigger->mFludd->mNozzleDeform.mBomb && trigger != &trigger->mFludd->mNozzleYoshiDeform.mBomb;
+}
+
+#ifdef TARGET_PC
+static bool infiniteSprayPressure(TNozzleBase* nozzle, TWaterGun* fludd)
+{
+	return infiniteFludd(fludd) && nozzle == &fludd->mNozzleDeform
+	    && fludd->mNozzleDeform.mBomb.getSprayState() == TNozzleTrigger::INACTIVE;
+}
+#endif
