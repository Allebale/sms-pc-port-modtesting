Reason: the puddles' and water's reflection (TMirrorCamera::makeMirrorViewMtx) mirrors the camera's view as it is drawn (its view matrix, unk1EC), not unk124/unk148: a mod that moves the view for a tick (port_ext_camera, as the First Person mod does) leaves those where the game's camera is, and the reflection was of that other view. Unmoved, the two are the same.

--- a/src/Map/MapMirror.cpp
+++ b/src/Map/MapMirror.cpp
@@ -78,10 +78,34 @@
 	MapMirrorPlane plane(unk84.x, unk84.y, unk84.z, -unk90);
 	MapMirrorVecs vecs;
 
+#ifdef TARGET_PC
+	// port: the eye and the point looked at as the camera's view has them
+	// (unk1EC): a mod may move the view for a tick (port_ext_camera, as the
+	// First Person mod does) and leave unk124 and unk148 where the game's
+	// camera is, which would mirror the wrong view. The same as those when
+	// nothing moved it.
+	JGeometry::TVec3<f32> eye, at;
+	{
+		MtxPtr v = gpCamera->getUnk1EC();
+		for (int j = 0; j < 3; j++) {
+			const f32 e = -(v[0][j] * v[0][3] + v[1][j] * v[1][3] + v[2][j] * v[2][3]);
+			(&eye.x)[j] = e;
+		}
+		JGeometry::TVec3<f32> d = gpCamera->unk148;
+		d -= gpCamera->unk124;
+		f32 dist = sqrtf(d.x * d.x + d.y * d.y + d.z * d.z);
+		if (dist < 1.0f)
+			dist = 1000.0f;
+		at.set(eye.x - v[2][0] * dist, eye.y - v[2][1] * dist, eye.z - v[2][2] * dist);
+	}
+	unk98.scaleAdd(plane.calcReflectScale(eye), plane.mNormal, eye);
+	vecs.mTarget.scaleAdd(plane.calcReflectScale(at), plane.mNormal, at);
+#else
 	unk98.scaleAdd(plane.calcReflectScale(gpCamera->unk124), plane.mNormal,
 	               gpCamera->unk124);
 	vecs.mTarget.scaleAdd(plane.calcReflectScale(gpCamera->unk148),
 	                      plane.mNormal, gpCamera->unk148);
+#endif
 	vecs.mUp.scaleAdd(plane.calcReflectScale(gpCamera->mUp), plane.mNormal,
 	                  gpCamera->mUp);
 
