+// How many times slower puddles dry this tick. As the water's slots fill
+// (past 60% of them in use), they dry faster, back to the game's own speed
+// when every slot is in use: the oldest dry away gradually, rather than being
+// taken whole for new water (emitRequest), which made puddles blink out and
+// in when FLUDD sprays hard in a small room.
+static f32 portPuddleDryScale(int used, int slots)
+{
+	const int scale = portPuddleScale();
+	if (scale <= 1 || slots <= 0)
+		return 1.0f;
+	const f32 from = slots * 0.6f;
+	if (used <= from)
+		return (f32)scale;
+	f32 t = (used - from) / (slots - from);
+	t     = t > 1.0f ? 1.0f : t;
+	return scale + (1.0f - scale) * t;
+}
 #endif
 
