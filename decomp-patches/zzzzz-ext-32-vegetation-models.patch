+#ifdef TARGET_PC
+		J3DModelData* data = loader.load(i_data, i_flags);
+		port_veg_model(data);
+		return data;
+#else
 		return loader.load(i_data, i_flags);
+#endif
 	}
 
 	return nullptr;
