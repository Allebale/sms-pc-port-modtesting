+// An updateMeaning(button, meaning, prevMeaning) inlined below, with the
+// instructions a mod may rewrite in it. Retail compiles each one as
+//   at-4  lwz    r0, mButton.mTrigger
+//   at    rlwinm. r0, r0, 0, <button>      bne set
+//   at+8  lwz    r0, mButton.mButton
+//   at+C  rlwinm. r0, r0, 0, <button>      beq skip
+//   at+14 rlwinm. r0, r31, 0, <meaning>    (r31 = prevMeaning)
+//   at+18 beq    skip
+//   set:  lwz r0, mMeaning; at+20 ori r0, r0, <meaning>; stw r0, mMeaning
+// BetterSunshineMoveset's Long Jump/Crouch Button setting
+// (LongJumpMappingSetting::valueChanged) rewrites the masks, the `ori` and
+// the `beq` at at+18 (to a nop: a held button keeps the meaning) to swap L
+// and Z: set to L, L crouches, long jumps and ground pounds (meaning 0x1000,
+// which it also makes TMario test for the ground pound) and Z centres the
+// camera (0x2000, 0x8000).
+static void smsModUpdateMeaning(TMarioGamePad* pad, u32 at, u32 button, u32 meaning,
+                                u32 prevMeaning)
+{
+	bool held = (pad->mButton.mButton & SMS_MOD_MASK(at + 0xC, button)) != 0
+	            && (SMS_MOD_WORD(at + 0x18, 0) == 0x60000000
+	                || (prevMeaning & SMS_MOD_MASK(at + 0x14, meaning)) != 0);
+	if ((pad->mButton.mTrigger & SMS_MOD_MASK(at, button)) != 0 || held)
+		pad->mMeaning |= SMS_MOD_ORI(at + 0x20, meaning);
+}
+#endif
