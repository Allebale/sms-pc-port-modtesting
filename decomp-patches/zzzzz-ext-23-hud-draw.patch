+	// left out with the water gauge when that is hidden (port_hud_draw)
+	if (gpMarioOriginal->mYoshi->onYoshi()
+	    && !(port_hud_hidden() & PORT_HUD_WATER)) {
 		switch (gpModelWaterManager->unk5D5F) {
 		case 1:
 			console->drawJuice(graph, (console->unkA2.r << 24)
@@ -4930,6 +4933,12 @@
 	if (flags & 2)
 		updateBalloon(this);
 
-	if (flags & 8)
+	if (flags & 8) {
