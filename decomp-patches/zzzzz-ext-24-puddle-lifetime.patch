+#ifdef TARGET_PC
+// port: puddles that last longer (the settings menu's Puddle Lifetime,
+// port_puddles.h). A landed drop (a puddle, on a floor or a wall) dries
+// port_puddle_life_scale() times slower, so it lasts as many times longer.
+// What a puddle does to the game while it lasts (it cleans the goop under it,
+// and sprays the object it sits on) is done only every scale-th tick, so each
+// puddle does as much of it as in the original game, over its longer life.
+// At 1 (Original) all of it is as the game has it.
+static int portPuddleScale()
+{
+	const int scale = port_puddle_life_scale();
+	return scale > 1 ? scale : 1;
+}
+
+// Whether a landed puddle acts on the game this tick.
+static bool portPuddleActs(int tick)
+{
+	const int scale = portPuddleScale();
+	return scale == 1 || tick % scale == 0;
+}
+#endif
